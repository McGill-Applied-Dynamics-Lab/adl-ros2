{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File (ROS2)",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "python": "${workspaceFolder}/.pixi/envs/humble/bin/python",
            "pythonArgs": [
                "-Xfrozen_modules=off"
            ],
            "args": [],
            // "preLaunchTask": "gen-vscode-env",
            "envFile": "${workspaceFolder}/.vscode/.env.humble",
            "env": {
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            },
            "console": "integratedTerminal",
            "pathMappings": [
                // {
                //     "localRoot": "${workspaceFolder}/src",
                //     "remoteRoot": "/home/athena/csirois/git/adl-ros2/build_humble"
                // },
                // {
                //     "localRoot": "${workspaceFolder}/src",
                //     "remoteRoot": "/home/athena/csirois/git/adl-ros2/install_humble"
                // },
                // {
                //     "localRoot": "${workspaceFolder}/",
                //     "remoteRoot": "/home/athena/csirois/git/adl-ros2/"
                // }
            ]
        },
        {
            "name": "Python Debugger: Remote Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            }
        },
        {
            "name": "pytest: Current File",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "python": "${workspaceFolder}/.pixi/envs/humble/bin/python",
            "pythonArgs": [
                "-Xfrozen_modules=off"
            ],
            "args": [
                "${file}",
                "-v",
                "-s",
                "--tb=short"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/src",
                    "remoteRoot": "/home/athena/csirois/git/adl-ros2/build_humble"
                },
                {
                    "localRoot": "${workspaceFolder}/src",
                    "remoteRoot": "/home/athena/csirois/git/adl-ros2/install_humble"
                },
                {
                    "localRoot": "${workspaceFolder}/src",
                    "remoteRoot": "/home/athena/csirois/git/adl-ros2/src"
                }
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/install_humble/arm_client/lib/python3.12/site-packages:${workspaceFolder}/install_humble/franka_rim/lib/python3.12/site-packages",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            }
        },
        {
            "name": "pytest: robot_arm_testing",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "python": "${workspaceFolder}/.pixi/envs/humble/bin/python",
            "pythonArgs": [
                "-Xfrozen_modules=off"
            ],
            "args": [
                "${workspaceFolder}/src/robot_arm/robot_arm_testing/test/",
                "-v",
                "-s",
                "--tb=short"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src:${workspaceFolder}/install_humble/arm_client/lib/python3.12/site-packages:${workspaceFolder}/install_humble/franka_rim/lib/python3.12/site-packages",
                "PYDEVD_DISABLE_FILE_VALIDATION": "1"
            }
        },
        {
            "name": "Python Debugger: rim_teleop",
            "type": "debugpy",
            "request": "launch",
            // "program": "${workspaceFolder}/python/rim_teleop/src/rim_teleop/main.py",
            "program": "${workspaceFolder}/python/rim_teleop/scripts/run_experiment.py",
            "python": "${workspaceFolder}/.pixi/envs/humble/bin/python",
            "pythonArgs": [
                "-Xfrozen_modules=off", // To speed up debugger launch
            ],
            // "preLaunchTask": "gen-vscode-env",
            "envFile": "${workspaceFolder}/.vscode/.env.humble",
            "env": {
                "PYDEVD_DISABLE_FILE_VALIDATION": "1" // To speed up debugger launch
            },
            "console": "internalConsole",
            "args": [
                "--config",
                "${workspaceFolder}/python/rim_teleop/configs/rim_teleop_default.yaml",
                // "--dry-run"
            ],
            "pathMappings": [
                // {
                //     "localRoot": "${workspaceFolder}/src",
                //     "remoteRoot": "/home/athena/csirois/git/adl-ros2/build_humble"
                // },
                // {
                //     "localRoot": "${workspaceFolder}/src",
                //     "remoteRoot": "/home/athena/csirois/git/adl-ros2/install_humble"
                // },
                // {
                //     "localRoot": "${workspaceFolder}/src/robot_arm/arm_client_rim",
                //     "remoteRoot": "/home/athena/csirois/git/adl-ros2/build_humble/arm_client_rim"
                // },
                // {
                //     "localRoot": "${workspaceFolder}/src/robot_arm/arm_client_rim",
                //     "remoteRoot": "/home/athena/csirois/git/adl-ros2/install_humble/arm_client_rim"
                // },
                // {
                //     "localRoot": "${workspaceFolder}/",
                //     "remoteRoot": "/home/athena/csirois/git/adl-ros2/"
                // }
            ]
        },
        {
            "name": "Python: haptic stability bench",
            "type": "debugpy",
            "request": "launch",
            // "program": "${workspaceFolder}/python/rim_teleop/src/rim_teleop/main.py",
            "program": "${workspaceFolder}/python/rim_teleop/examples/stability_bench.py",
            "python": "${workspaceFolder}/.pixi/envs/humble/bin/python",
            "pythonArgs": [
                "-Xfrozen_modules=off", // To speed up debugger launch
            ],
            // "preLaunchTask": "gen-vscode-env",
            "envFile": "${workspaceFolder}/.vscode/.env.humble",
            "env": {
                "PYDEVD_DISABLE_FILE_VALIDATION": "1" // To speed up debugger launch
            },
            "console": "internalConsole",
            "args": [
                "--stiffness",
                "2000",
                "--damping",
                "0",
                "--rate",
                "1000",
                "--duration",
                "10"
            ],
        },
    ]
}