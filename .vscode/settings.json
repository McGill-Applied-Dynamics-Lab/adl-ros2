    //! Pytest
    "python.testing.pytestArgs": [
        "src/",
        "--ignore=src/_legacy",
    ],
    // "python.testing.pytestPath": "/usr/bin/pytest-3"
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "python.testing.autoTestDiscoverOnSaveEnabled": false,
    "terminal.integrated.profiles.linux": {
        "pixi-humble": {
            "path": "bash",
            "args": [
                "--rcfile",
                "${workspaceFolder}/.vscode/activate-env.sh"
            ]
        },
        "bash (plain)": {
            "path": "bash"
        }
    },
    "terminal.integrated.defaultProfile.linux": "pixi-humble",
    //
    "ros.distro": "humble",
    // Spell Right
    "spellright.language": [
        "en_CA"
    ],
    "spellright.documentTypes": [
        "markdown",
        "latex",
        "plaintext"
    ],
    // Alternative: Configure file exclusions to hide build directory duplicates
    "files.exclude": {
        "**/build/**/*.py": true,
        "**/install/**/*.py": true
    },
    "ROS2.distro": "humble",
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "python-envs.pythonProjects": []
}