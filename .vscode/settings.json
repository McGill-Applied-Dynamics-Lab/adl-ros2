{
    "python.defaultInterpreterPath": "${workspaceFolder}/.pixi/envs/humble/bin/python",
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/build_humble",
        "${workspaceFolder}/install_humble",
        "${workspaceFolder}/install_humble/arm_client/lib/python3.12/site-packages",
        "${workspaceFolder}/install_humble/arm_interfaces/lib/python3.12/site-packages"
    ],
    "python.analysis.extraPaths": [
        "${workspaceFolder}/src",
        "${workspaceFolder}/src/arm_client",
        "${workspaceFolder}/src/arm_interfaces",
        "${workspaceFolder}/src/robot_arm",
        "${workspaceFolder}/src/robot_tasks",
        "${workspaceFolder}/src/teleop",
        "${workspaceFolder}/build_humble",
        "${workspaceFolder}/install_humble",
        "${workspaceFolder}/install_humble/arm_client/lib/python3.12/site-packages",
        "${workspaceFolder}/install_humble/arm_interfaces/lib/python3.12/site-packages",
        // "/opt/openrobots/lib/python3.10/site-packages",
        "/usr/local/lib/python3.10/site-packages",
    ],
    "files.associations": {
        "*.sty": "latex",
