{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run-current-file-in-container",
      "type": "shell",
      "command": "docker",
      "args": [
        "exec",
        "-it",
        "adl_ros2",
        "bash",
        "-c",
        "source /home/ros/ros2_ws/install/setup.bash && cd /home/ros/ros2_ws/src/adl-ros2 && python ${relativeFile} --no-prompt"
      ],
      "isBackground": false,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "colcon build",
      "type": "shell",
      "command": [
        // "source /opt/ros/humble/setup.sh &&",
        // "cd ${workspaceFolder}/../.. &&",
        // "colcon build",
        // "--symlink-install",
        // "--cmake-args '-DCMAKE_BUILD_TYPE=Debug'"
        "pixi run -e humble build"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "colcon test && colcon test-result"
    },
    {
      "label": "fr3 - rim exp setup",
      "type": "shell",
      "command": [
        "cd ${workspaceFolder} &&",
        "python src/robot_arm/franka_rim/scripts/i3_teleop_setup.py"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "fr3 - home",
      "type": "shell",
      "command": [
        "cd ${workspaceFolder} &&",
        "pixi run -e humble python examples/00_home.py"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Source ROS2 ws",
      "type": "shell",
      "command": "source ${workspaceFolder}/install_humble/setup.bash && sleep 1"
    },
    {
      "label": "gen-vscode-env",
      "type": "shell",
      "command": "pixi run -e humble gen-vscode-env",
      "problemMatcher": []
    },
    {
      "label": "ROS2 Test - robot_arm_testing",
      "type": "shell",
      "command": [
        "source ~/.zshrc && ",
        "colcon test",
        "--event-handlers console_direct+",
        "--packages-select robot_arm_testing",
        "&& xunit-viewer -r ${workspaceFolder}/build/robot_arm_testing/test_results"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "robot_ip",
      "type": "promptString",
      "description": "Robot IP address",
      "default": "dont-care"
    },
    {
      "id": "hw_type",
      "type": "pickString",
      "description": "Hardware type",
      "options": [
        "isaac",
        "fake",
        "real",
        "gazebo"
      ],
      "default": "real"
    }
  ]
}